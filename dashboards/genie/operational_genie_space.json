    "example_question_sqls": [
      {
        "id": "44000000000000000000000000000001",
        "question": [
          "What is the current verdict, disposition, and approved amount for claim CLM-0004962?"
        ],
        "sql": [
          "SELECT c.claim_id, c.claim_type, c.defect_code, a.decision_status, a.recommended_verdict, a.verdict, a.disposition, a.approved_amount, a.override_flag, a.override_reason FROM `fe-bar-ir`.gold.claims_current AS c JOIN `fe-bar-ir`.gold.adjudications_current AS a ON c.claim_id = a.claim_id WHERE c.claim_id = 'CLM-0004962'"
        ]
      },
      {
        "id": "44000000000000000000000000000002",
        "question": [
          "Show finalized claims that were overridden and include the recorded override reason."
        ],
        "sql": [
          "SELECT c.claim_id, a.adjudication_id, a.recommended_verdict, a.verdict, a.disposition, a.approved_amount, a.override_reason, a.decided_by, a.finalized_at FROM `fe-bar-ir`.gold.claims_current AS c JOIN `fe-bar-ir`.gold.adjudications_current AS a ON c.claim_id = a.claim_id WHERE a.decision_status = 'FINAL' AND a.override_flag = true ORDER BY a.finalized_at DESC LIMIT 100"
        ]
      }
    ]
