{
  "datasets": [
    {"name":"executive_kpis","displayName":"Governed executive KPIs","queryLines":["SELECT MEASURE(`Claim Count`) AS claim_count, MEASURE(`Approval Rate`) AS approval_rate, MEASURE(`Denial Rate`) AS denial_rate, MEASURE(`Pend Rate`) AS pend_rate, MEASURE(`Claimed Amount`) AS claimed_amount, MEASURE(`Approved Amount`) AS approved_amount, MEASURE(`In Spec Denial Amount`) AS in_spec_denial_amount, MEASURE(`Warranty Exclusion Denial Amount`) AS warranty_exclusion_denial_amount, MEASURE(`Duplicate Blocked Amount`) AS duplicate_blocked_amount, MEASURE(`Over Claim Reduction Amount`) AS over_claim_reduction_amount ","FROM quality_claims_metrics "]},
    {"name":"cycle_time","displayName":"Cycle time","queryLines":["SELECT AVG(average_cycle_time_days) AS average_cycle_time_days ","FROM gold_quality_kpis "]},
    {"name":"quality_pareto","displayName":"Failure mode Pareto","queryLines":["SELECT failure_mode_code, defect_description, line, grade, coating, SUM(claim_count) AS claims, SUM(affected_tonnage) AS affected_tonnage, SUM(affected_claimed_amount) AS affected_claimed_amount ","FROM gold_failure_mode_analytics GROUP BY ALL ORDER BY claims DESC LIMIT 20 "]},
    {"name":"quarantine","displayName":"Quarantine candidates","queryLines":["SELECT heat_no, line, grade, coating, failure_mode_code, SUM(claim_count) AS recurrence, SUM(affected_tonnage) AS affected_tonnage, SUM(affected_claimed_amount) AS affected_claimed_amount ","FROM gold_failure_mode_analytics WHERE quarantine_candidate = true GROUP BY ALL ORDER BY recurrence DESC LIMIT 50 "]},
    {"name":"finance","displayName":"Approved value by disposition","queryLines":["SELECT `Disposition` AS disposition, `Product` AS product, `Region` AS region, MEASURE(`Approved Amount`) AS approved_amount ","FROM quality_claims_metrics GROUP BY ALL ORDER BY approved_amount DESC "]},
    {"name":"supplier","displayName":"Supplier attributable recovery opportunity","queryLines":["SELECT COALESCE(NULLIF(supplier, ''), 'Unassigned') AS supplier, SUM(supplier_attributable_amount) AS supplier_attributable_amount, SUM(supplier_attributable_count) AS claim_count ","FROM gold_supplier_recovery_analytics GROUP BY 1 ORDER BY supplier_attributable_amount DESC "]},
    {"name":"fraud","displayName":"Fraud cluster risk","queryLines":["SELECT cluster_id, customer_name, heat_no, SUM(risky_claim_count) AS risky_claims, SUM(risky_claimed_amount) AS risky_claimed_amount, MAX(customer_heat_risk_score) AS risk_score ","FROM gold_fraud_cluster_analytics GROUP BY ALL ORDER BY risky_claimed_amount DESC LIMIT 30 "]},
    {"name":"alignment","displayName":"Agent-human alignment subset","queryLines":["SELECT SUM(adjudication_count) AS adjudications, SUM(verdict_agreement_count) / NULLIF(SUM(adjudication_count), 0) AS verdict_agreement_rate, SUM(override_rate * adjudication_count) / NULLIF(SUM(adjudication_count), 0) AS override_rate ","FROM gold_agent_human_alignment "]},
    {"name":"citations","displayName":"Citation coverage subset","queryLines":["SELECT SUM(decision_record_count) AS decision_records, SUM(citation_coverage * decision_record_count) / NULLIF(SUM(decision_record_count), 0) AS citation_coverage ","FROM gold_retrieval_citation_kpis "]}
  ],
